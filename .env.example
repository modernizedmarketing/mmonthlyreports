ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=your_google_drive_folder_id
REPORT_INSIGHTS_PROVIDER=deterministic
ANTHROPIC_INSIGHTS_MODEL=claude-sonnet-4-6
OPENAI_INSIGHTS_MODEL=gpt-5.4-mini
MASTER_CONTROL_SHEET_ID=your_master_control_sheet_id
CONTROL_SHEET_CLIENTS_SHEET=Clients
CONTROL_SHEET_RUNS_SHEET=Runs
CLOUD_RUN_PROJECT=your_gcp_project_id
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_JOB_NAME=monthly-report-batch
CLOUD_RUN_JOB_CONTAINER_NAME=

# Cloud Run / production mode:
# Mount a service-account JSON and point this env var to the mounted path.
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/google/service-account.json

# Local OAuth mode:
# Keep GOOGLE_SERVICE_ACCOUNT_FILE unset and use local credentials.json/token files instead.
